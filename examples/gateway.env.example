# Example only. Keep the real key file outside this repository.
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8000
GATEWAY_API_KEY_FILE=/absolute/path/outside/repository/mcp-api-key
GATEWAY_BACKEND_COMMAND=/absolute/path/to/stdio-mcp-server
GATEWAY_BACKEND_CWD=/workspace
GATEWAY_SESSION_TTL_MS=1800000
GATEWAY_MAX_SESSIONS=8
# GATEWAY_BACKEND_ARGS=["arg1","arg2"]
# GATEWAY_BACKEND_ENV={"SAFE_BACKEND_SETTING":"value"}
# GATEWAY_ALLOWED_ORIGINS=https://trusted.example